# Chat model.
# Local default is Ollama (the original GPT-OSS setup). The backend Docker
# image sets MODEL_PROVIDER=openai so a Railway deploy does not look for a
# local Ollama. Override it on the service if you use another host.
MODEL_PROVIDER=ollama
MODEL_NAME=gpt-oss:20b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required on Railway and whenever MODEL_PROVIDER=openai.
# Leave blank locally when you are using Ollama.
OPENAI_API_KEY=
# Optional. Set this for an OpenAI-compatible host (not api.openai.com).
OPENAI_BASE_URL=

# Free key from https://www.nps.gov/subjects/developer/get-started.htm
# When set, the app starts the NPS MCP server locally first, then tries the
# hosted MCP server, then the NPS REST API. Leave blank to skip the local
# server and the REST API. OpenStreetMap is the last resort and is labeled
# "not verified by NPS".
NPS_API_KEY=

# Local NPS MCP server. Used only when NPS_API_KEY is set.
# The backend image includes Node so npx works. If npx fails, the app
# continues with the hosted server, the REST API, or OpenStreetMap.
NPS_MCP_COMMAND=npx
NPS_MCP_ARGS=-y,@cyanheads/national-parks-mcp-server@0.3.0

# Hosted National Park Service MCP server (same package). Tried after local stdio.
# Set NPS_MCP_ENABLED=false to skip both MCP servers.
NPS_MCP_URL=https://national-parks.caseyjhand.com/mcp
NPS_MCP_ENABLED=true
NPS_MCP_TIMEOUT_SECONDS=12

# Keyless weather MCP: NOAA for US points, Open-Meteo elsewhere, plus alerts.
# Requires Node.js because the server is started with npx. On failure the app
# calls Open-Meteo and api.weather.gov directly.
WEATHER_MCP_ENABLED=true
WEATHER_MCP_COMMAND=npx
WEATHER_MCP_ARGS=-y,@dangahagan/weather-mcp@1.35.17
WEATHER_MCP_TIMEOUT_SECONDS=25

HTTP_TIMEOUT_SECONDS=20
HIKE_USER_AGENT=hike-agent/0.1 (educational hike planner)

# LangGraph server. Railway sets PORT. Locally `langgraph dev` uses 2024.
# The in-memory server does not need LANGSMITH_API_KEY or a LangGraph license.
PORT=2024
# Comma-separated browser origins. Default * lets the chat UI on another host call the API.
CORS_ALLOW_ORIGINS=*

# --- Frontend (copy the block below into ui/.env, or set it on the Railway UI service) ---
# NEXT_PUBLIC_* is baked in at `next build`. On Railway, point the URL at the
# backend service with a reference variable (the backend service name here is hike-api):
#   NEXT_PUBLIC_API_URL=https://${{hike-api.RAILWAY_PUBLIC_DOMAIN}}
#   NEXT_PUBLIC_ASSISTANT_ID=hike_planner
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=hike_planner
NEXT_PUBLIC_AUTH_SCHEME=
# Unused when the browser talks to NEXT_PUBLIC_API_URL directly.
LANGGRAPH_API_URL=http://localhost:2024
LANGSMITH_API_KEY=
