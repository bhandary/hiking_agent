# Chat model. The default keeps the original local GPT-OSS setup.
# MODEL_PROVIDER=ollama uses Ollama. MODEL_PROVIDER=openai uses the OpenAI API,
# or another OpenAI-compatible server when OPENAI_BASE_URL is set.
MODEL_PROVIDER=ollama
MODEL_NAME=gpt-oss:20b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required only when MODEL_PROVIDER=openai (or openai-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Free key from https://www.nps.gov/subjects/developer/get-started.htm
# Used by the direct National Park Service fallback when the NPS MCP server is down.
# Leave blank to skip that API. OpenStreetMap is then used as a keyless trail source.
NPS_API_KEY=

# Hosted National Park Service MCP server (cyanheads/national-parks-mcp-server).
# Set NPS_MCP_ENABLED=false to skip it and use NPS_API_KEY or OpenStreetMap.
NPS_MCP_URL=https://national-parks.caseyjhand.com/mcp
NPS_MCP_ENABLED=true
NPS_MCP_TIMEOUT_SECONDS=12

# Keyless weather MCP: NOAA for US points, Open-Meteo elsewhere, plus alerts.
# Requires Node.js because the server is started with npx. On failure the app
# calls Open-Meteo and api.weather.gov directly.
WEATHER_MCP_ENABLED=true
WEATHER_MCP_COMMAND=npx
WEATHER_MCP_ARGS=-y,@dangahagan/weather-mcp@1.35.17
WEATHER_MCP_TIMEOUT_SECONDS=25

HTTP_TIMEOUT_SECONDS=20
HIKE_USER_AGENT=hike-agent/0.1 (educational hike planner)
